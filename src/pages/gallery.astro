---
import MainGridLayout from '@layouts/MainGridLayout.astro';
import { Icon } from 'astro-icon/components';

const projects = [
  {
    title: '博客网站',
    description: '基于 Astro Fuwari 主题的个人博客，支持暗黑模式、搜索、Mermaid 图表等功能。',
    image: '/gallery/blog-preview.png',
    link: 'https://github.glmyx.eu.org',
    tags: ['Astro', 'Svelte', 'Tailwind'],
  },
  // 在这里添加更多作品：
  // {
  //   title: '项目名称',
  //   description: '项目描述...',
  //   image: '/gallery/xxx.png',
  //   link: 'https://xxx',
  //   tags: ['标签1', '标签2'],
  // },
];
---

<MainGridLayout title="作品集" description="我的项目和作品展示">
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
    <div class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
      <div class="onload-animation mb-6">
        <div class="flex items-center gap-3 mb-2">
          <Icon name="material-symbols:photo-library-outline-rounded" class="text-[2rem] text-[var(--primary)]" />
          <h1 class="text-2xl md:text-3xl font-bold text-black/90 dark:text-white/90">作品集</h1>
        </div>
        <p class="text-black/50 dark:text-white/50">这里展示我的项目和作品。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 onload-animation">
        {projects.map((project, i) => (
          <a href={project.link || '#'}
             class="group card-base rounded-xl overflow-hidden hover:scale-[1.02] active:scale-95 transition-all duration-200 flex flex-col"
             style={`animation-delay: calc(var(--content-delay) + ${i * 75}ms)`}
          >
            <div class="h-40 bg-[var(--btn-regular-bg)] flex items-center justify-center overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
              />
              <div class="hidden flex-col items-center justify-center text-[var(--primary)]">
                <Icon name="material-symbols:image-outline" class="text-[3rem] mb-1" />
                <span class="text-sm">预览图</span>
              </div>
            </div>
            <div class="p-4 flex flex-col gap-2 flex-1">
              <h3 class="font-bold text-lg text-black/90 dark:text-white/90">{project.title}</h3>
              <p class="text-sm text-black/50 dark:text-white/50 flex-1">{project.description}</p>
              <div class="flex flex-wrap gap-1.5 mt-1">
                {project.tags?.map(tag => (
                  <span class="text-xs px-2 py-0.5 rounded-md bg-[var(--primary)]/10 text-[var(--primary)] font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

      {projects.length === 0 && (
        <div class="text-center py-16 text-black/30 dark:text-white/30 onload-animation">
          <Icon name="material-symbols:folder-open-outline" class="text-[4rem] mx-auto mb-3" />
          <p>暂无作品，敬请期待...</p>
        </div>
      )}
    </div>
  </div>
</MainGridLayout>
